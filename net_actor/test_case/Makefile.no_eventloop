# Makefile.no_eventloop - 无 EventLoop 版 Actor 消息测试
# 用法: make -f Makefile.no_eventloop   （在 test_case/ 目录下执行）
#
# [新增] 原 run_test_no_eventloop.sh 调用 Makefile.test 构建的是 test_actor_msg，
#        并未真正测试 test_actor_msg_no_eventloop.cc。新增此 Makefile 修正。

.PHONY: all clean

CXX      = g++
CXXFLAGS = -Wall -g -m64 -fPIC -std=c++20 -fcoroutines -pthread -MMD -MP -include precompiled.h
INCLUDE  = -I./ -I..
LDFLAGS  = -L./ -L../../lib
LDLIBS   = -ldl -pthread

BIN_PATH = .
TARGET   = test_actor_msg_no_eventloop

SOURCES  = test_actor_msg_no_eventloop.cc \
           ../Actor.cc \
           ../ActorSystem.cc \
           ../Timer.cc \
           ../EventLoop.cc \
           ../Epollor.cc \
           ../ConnectionBase.cc \
           ../Connection.cc \
           ../Acceptor.cc \
           ../Connector.cc \
           ../IOHelper.cc

OBJ_DIR  = ../../Obj/NetNoEventLoop
OBJECTS  = $(addprefix $(OBJ_DIR)/,$(notdir $(SOURCES:.cc=.o)))
DEPS     = $(OBJECTS:.o=.d)

all: $(BIN_PATH)/$(TARGET)

$(BIN_PATH)/$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $^ $(LDFLAGS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: %.cc | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJ_DIR)/%.o: ../%.cc | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

-include $(DEPS)

clean:
	rm -rf $(OBJ_DIR) $(BIN_PATH)/$(TARGET)
