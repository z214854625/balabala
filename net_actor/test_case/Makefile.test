# Makefile.test - Actor 间消息测试
# 用法: make -f Makefile.test   （在 test_case/ 目录下执行）

.PHONY: all clean

CXX      = g++
CXXFLAGS = -Wall -g -m64 -fPIC -std=c++20 -fcoroutines -pthread -MMD -MP -include precompiled.h
INCLUDE  = -I./ -I..
LDFLAGS  = -L./ -L../../lib
LDLIBS   = -ldl -pthread

BIN_PATH = .
TARGET   = test_actor_msg

# 测试源（当前目录）+ 框架核心（../）
SOURCES  = test_actor_msg.cc \
           ../Actor.cc \
           ../ActorSystem.cc \
           ../Timer.cc \
           ../EventLoop.cc \
           ../Epollor.cc \
           ../ConnectionBase.cc \
           ../Connection.cc \
           ../Acceptor.cc \
           ../Connector.cc \
           ../IOHelper.cc

OBJ_DIR  = ../../Obj/NetTest
OBJECTS  = $(addprefix $(OBJ_DIR)/,$(notdir $(SOURCES:.cc=.o)))
DEPS     = $(OBJECTS:.o=.d)

all: $(BIN_PATH)/$(TARGET)

$(BIN_PATH)/$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $^ $(LDFLAGS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: %.cc | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJ_DIR)/%.o: ../%.cc | $(OBJ_DIR)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

-include $(DEPS)

clean:
	rm -rf $(OBJ_DIR) $(BIN_PATH)/$(TARGET)
