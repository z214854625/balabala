# Makefile.lua_state - LuaActor Phase 2 状态服务测试构建
# 用法: make -f Makefile.lua_state   （在 test_case/ 目录下执行）

.PHONY: all clean

CXX      = g++
CXXFLAGS = -Wall -g -m64 -fPIC -std=c++20 -fcoroutines -pthread -MMD -MP -include precompiled.h

INCLUDE  = -I./ -I.. -I../../include -I../../include/lua5.4 -I../../include/sol

LDFLAGS  = -L./ -L../../lib
LDLIBS   = -l:cmsgpack.so -llua-5.4 -ldl -pthread

BIN_PATH = .
TARGET   = test_actor_lua_state

TEST_SOURCES = test_actor_lua_state.cc \
               ../LuaEnv.cc \
               ../LuaActor.cc \
               ../LuaBridge.cc \
               ../Actor.cc \
               ../ActorSystem.cc \
               ../Timer.cc \
               ../EventLoop.cc \
               ../Epollor.cc \
               ../ConnectionBase.cc \
               ../Connection.cc \
               ../Acceptor.cc \
               ../Connector.cc \
               ../IOHelper.cc

OBJECT_PATH    = ../../Obj/LuaState
OBJECTS        = $(addprefix $(OBJECT_PATH)/,$(notdir $(TEST_SOURCES:.cc=.o)))
DEPS           = $(OBJECTS:.o=.d)

all: $(BIN_PATH)/$(TARGET)

$(BIN_PATH)/$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $^ $(LDFLAGS) $(LDLIBS) -o $@

$(OBJECT_PATH)/%.o: %.cc | $(OBJECT_PATH)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJECT_PATH)/%.o: ../%.cc | $(OBJECT_PATH)
	$(CXX) $(CXXFLAGS) -c $< $(INCLUDE) -o $@

$(OBJECT_PATH):
	mkdir -p $(OBJECT_PATH)

-include $(DEPS)

clean:
	rm -rf $(OBJECT_PATH)/*.o $(OBJECT_PATH)/*.d $(BIN_PATH)/$(TARGET)
